<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Switch to "production" for the App Store build. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Gymix links (door stickers, invites) open the app. Needs the paid Apple
	     account and the apple-app-site-association file on the website. -->
	<!-- Shared with the home-screen widget (its token and last numbers). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.gymix.app</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:gymix-seven.vercel.app</string>
	</array>
</dict>
</plist>
