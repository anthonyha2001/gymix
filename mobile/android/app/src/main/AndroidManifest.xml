<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Gymix links open the app instead of the browser: door and check-in
                 stickers, invites, machine stickers, shared programs. The host comes
                 from gymixHost in gradle.properties (set by npm run sync). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${gymixHost}" />
                <data android:pathPrefix="/d/" />
                <data android:pathPrefix="/c/" />
                <data android:pathPrefix="/join/" />
                <data android:pathPrefix="/m/" />
                <data android:pathPrefix="/p/" />
                <data android:pathPrefix="/portal" />
            </intent-filter>
        </activity>

        <!-- The home-screen widget (GymixWidget.java). -->
        <receiver
            android:name=".GymixWidget"
            android:exported="false"
            android:label="Gymix">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/gymix_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vibration (door taps, slide to open, challenge cards). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The QR scanner and progress photos use the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Writing NFC stickers (GymixNfc). Not required: phones without NFC still install. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- "Phone must be at the gym" for door stickers. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
