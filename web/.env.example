# Public address of the site (e.g. https://gymix.app). Used in confirmation emails; leave empty locally.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: lets invite links sign members in without a password, and records
# traffic, logins and errors for the /admin control center.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails that become Gymix super admins on login and go straight to /admin.
SUPER_ADMIN_EMAILS=
# Set to "off" to stop recording traffic, logins and errors.
GYMIX_TELEMETRY=

# iPhone / Android app (mobile/). Fill in on launch day, then redeploy.
# Apple Developer → Membership → Team ID (10 characters).
APPLE_TEAM_ID=
# Google Play Console → App integrity → App signing → SHA-256 (comma-separate several).
ANDROID_CERT_SHA256=
# Only if the app ID ever differs from com.gymix.app.
GYMIX_APP_ID=
